# ─── Environment ───────────────────────────────────────────
# local | development | staging | production
NODE_ENV=staging
PORT=3000

# ─── URLs ──────────────────────────────────────────────────
APP_URL=http://localhost:5173
LANDING_URL=http://localhost:5173
CORS_URLS=http://localhost:5173
API_URL=http://localhost:3000/api

# ─── Database (PostgreSQL 14+) ─────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/quizme

# ─── Optional Redis (not required: jobs use a Postgres-backed queue) ──
REDIS_URL=
CACHE_TTL_SECONDS=

# ─── Auth ──────────────────────────────────────────────────
# Use a long random value in production (e.g. `openssl rand -hex 48`)
JWT_SECRET=change-me
JWT_EXPIRATION_TIME=30d
# Optional Google sign-in (OAuth client id used by the web app)
GOOGLE_CLIENT_ID=

# ─── AI ────────────────────────────────────────────────────
# auto | openai | anthropic | local  (auto picks the first configured provider)
AI_PROVIDER=auto
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional model overrides per tier (defaults: openai gpt-4.1-mini / gpt-4.1)
AI_MODEL_FAST=
AI_MODEL_SMART=
# auto | openai | local (local = offline hashed embeddings)
EMBEDDINGS_PROVIDER=auto
# Per-user rolling 24h token budget (cost control)
AI_DAILY_TOKEN_LIMIT=2000000

# ─── File storage ──────────────────────────────────────────
# Google Cloud Storage (recommended). When unset, files are stored on local disk in STORAGE_DIR.
GCS_PROJECT_ID=
GCS_BUCKET_NAME=
GCS_FOLDER_NAME=quizme
GCS_CREDENTIALS_JSON_BASE64=
STORAGE_DIR=./storage
MAX_UPLOAD_MB=50

# ─── Background worker ─────────────────────────────────────
WORKER_ENABLED=true
WORKER_CONCURRENCY=2

# ─── Email (Resend). When unset, emails are logged instead of sent. ──
RESEND_API_KEY=
SMTP_FROM=QuizMe <no-reply@example.com>

# ─── Unused integrations kept for compatibility ───────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
GOOGLE_MAPS_API_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BULL_BOARD_USER=
BULL_BOARD_PASSWORD=
